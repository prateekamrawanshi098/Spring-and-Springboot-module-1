<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="cus" class="in.spring.beans.Customer" autowire="byType" >
   <property name="name" value="Amit"></property>
    </bean>
    
    <bean id="accObj1" class="in.spring.beans.Account" autowire-candidate="false">
    <property name="acctId" value="SV-101"></property>
    <property name="balance" value="50000.0"></property>
    </bean>
    
    <bean id="accObj2" class="in.spring.beans.Account">
    <property name="acctId" value="SV-102"></property>
    <property name="balance" value="60000.0"></property>
    </bean>
    
</beans>