<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">
       
    <bean id="prg1" class="in.spring.beans.Programmer">
        <property name="name" value="Satish"/>
        <property name="cp" ref="ltp"></property>
    </bean>
    
     <bean id="prg2" class="in.spring.beans.Programmer">
        <property name="name" value="Manish"/>
        <property name="cp" ref="dtp"></property>
    </bean>

    <bean id="ltp" class="in.spring.beans.Laptop">
    </bean>
    
     <bean id="dtp" class="in.spring.beans.Desktop">
    </bean>
    
    


</beans>