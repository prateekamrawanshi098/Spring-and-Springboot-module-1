    {
      "id": "I8rGgzsxAfF0nDei1T8CQ",
      "type": "text",
      "x": 299,
      "y": 1003,
      "width": 641,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
