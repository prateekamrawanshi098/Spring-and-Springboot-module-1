      "seed": 507686635,
      "version": 195,
      "versionNonce": 938334571,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785042075227,
      "link": null,
      "locked": false,
      "text": "1. Libraries are used perform specific task only while while framework has a wide range of \nfunctionality  use to develop complete application.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Libraries are used perform specific task only while while framework has a wide range of \nfunctionality  use to develop complete application.",
      "autoResize": true,
      "lineHeight": 1.25
    },
