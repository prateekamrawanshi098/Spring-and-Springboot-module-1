    },
    {
      "id": "5EhcnKgN3FYflGqT1AgP-",
      "type": "text",
      "x": 292,
      "y": 1347,
      "width": 878,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
