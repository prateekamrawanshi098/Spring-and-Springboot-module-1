      "link": null,
      "locked": false,
      "text": "Library vs framework\n==================",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Library vs framework\n==================",
      "autoResize": true,
