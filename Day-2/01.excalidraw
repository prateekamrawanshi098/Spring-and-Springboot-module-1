      "updated": 1785047800928,
      "link": null,
      "locked": false,
      "text": "1. Spring Core                                 2. Spring Context\n\n3. SpringBoot                                 4. Spring JDBC\n\n5. Spring Data JPA                           6. Spring web MVC\n\n7. Spring REST                                8. Spring Security\n\n9 . Spring Cloud                                  10. Spring AI\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Spring Core                                 2. Spring Context\n\n3. SpringBoot                                 4. Spring JDBC\n\n5. Spring Data JPA                           6. Spring web MVC\n\n7. Spring REST                                8. Spring Security\n\n9 . Spring Cloud                                  10. Spring AI\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
