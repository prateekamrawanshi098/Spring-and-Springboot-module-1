      "locked": false,
      "text": "package in.spring.beans;\n\npublic class Programmer extends LapTop {\n        public void writeCode() {\n                boolean result = super.startLapto();\n                if (result) {\n                        System.out.println(\"Coding started\");\n\n                } else {\n                        System.out.println(\"Coding not started\");\n                }\n\n        }\n}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "package in.spring.beans;\n\npublic class Programmer extends LapTop {\n        public void writeCode() {\n                boolean result = super.startLapto();\n                if (result) {\n                        System.out.println(\"Coding started\");\n\n                } else {\n                        System.out.println(\"Coding not started\");\n                }\n\n        }\n}\n",
      "autoResize": true,
