    {
      "id": "yCcS14P-nWxsRcwCfAYJn",
      "type": "text",
      "x": 312,
      "y": 544,
      "width": 704,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
