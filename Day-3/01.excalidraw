      "index": "a7",
      "roundness": null,
      "seed": 6267790,
      "version": 272,
      "versionNonce": 1214615246,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785167710828,
      "link": null,
      "locked": false,
      "text": "1. Plain Old Java Object\n\n2. It is an ordinary class\n\n3. Does not need to implement or extend any framework specific class or interface.\n\n4. Can contain field constructor or methods.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Plain Old Java Object\n\n2. It is an ordinary class\n\n3. Does not need to implement or extend any framework specific class or interface.\n\n4. Can contain field constructor or methods.",
      "autoResize": true,
      "lineHeight": 1.25
    },
