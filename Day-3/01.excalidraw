      "boundElements": null,
      "updated": 1785168013969,
      "link": null,
      "locked": false,
      "text": "1. It is a POJO class with few restriction.\n\n2. It must contain non paramaterized constructor.\n\n3. It must contain private members.\n\n3. It must conatin setter and getter.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. It is a POJO class with few restriction.\n\n2. It must contain non paramaterized constructor.\n\n3. It must contain private members.\n\n3. It must conatin setter and getter.",
      "autoResize": true,
      "lineHeight": 1.25
