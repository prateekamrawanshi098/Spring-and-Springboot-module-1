<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="lp" class="in.spring.beans.Student">
     <constructor-arg  value="100"/>
     <constructor-arg  value="Satish"/>
     <constructor-arg  ref="ad" />
    </bean>
    
    <bean id="ad" class="in.spring.beans.Address" scope="prototype">
    <property name="HouseNo" value="201"/>
    <property name="city" value="Bhopal" />
    </bean>
    
</beans>